{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vote-counter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Production is served only on the custom domain below (the QR codes use it).
  // The REPLACE_WITH_* placeholders are filled in by `bun run ship` on its first run.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "vote.carlos-dev-research.com", "custom_domain": true }],

  // Static front end from public/. The Worker runs first only for the API and the voter page.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vote-counter",
      "database_id": "9da580b4-8daa-4479-99b2-8af55e5f8ce6",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (not listed here): ADMIN_EMAIL, ADMIN_PASSWORD, SESSION_SECRET
}
