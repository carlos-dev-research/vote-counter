{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vote-counter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Static front end from public/. The Worker runs first only for the API and the voter page.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v/*"]
  },

  // Create with: bunx wrangler d1 create vote-counter, then paste the database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vote-counter",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (not listed here): ADMIN_EMAIL, ADMIN_PASSWORD, SESSION_SECRET
}
