# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. `wrangler dev` loads it into the Worker's env.

# ── Toolchain ───────────────────────────────────────────────────────────────
# Bun version used for installing, building (bun build), tests, and running Wrangler.
# `bun run ship` refuses to deploy if the running Bun differs from this version.
# Keep in sync with "packageManager" in package.json.
BUN_VERSION=1.4.4

# The backend runs on the Cloudflare Workers runtime (workerd), not Bun.
# The Workers runtime is selected by compatibility_date in wrangler.jsonc.
WRANGLER_VERSION=4.163.0

# ── Secrets (local values only) ─────────────────────────────────────────────
# In production set them with:  bunx wrangler secret put <NAME>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
